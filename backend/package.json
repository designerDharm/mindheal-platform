{
  "name": "mindheal-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MindHeal backend API foundation with route contracts and local development store.",
  "scripts": {
    "dev": "node src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "check": "find src scripts \\( -name '*.js' -o -name '*.mjs' \\) -exec node --check {} \\;",
    "test:smoke": "npm run db:seed && node scripts/smoke-test.mjs",
    "test": "REPOSITORY_DRIVER=memory node --test tests/**/*.test.js",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:seed": "node scripts/run-migrations.mjs --seed"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@google/genai": "^2.8.0",
    "agora-token": "^2.0.5",
    "busboy": "^1.6.0",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.10.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "razorpay": "^2.9.6",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3"
  }
}
