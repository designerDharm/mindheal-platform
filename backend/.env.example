# Core Environment
NODE_ENV=development
PORT=4000

# Security
# Production requires explicit, high-entropy secrets of at least 32 characters.
# Generate unique values with: openssl rand -base64 48
JWT_ACCESS_SECRET=development-access-secret-change-me
JWT_REFRESH_SECRET=development-refresh-secret-change-me
# Required in production to encrypt admin-managed API keys at rest.
API_CONFIG_ENCRYPTION_KEY=development-api-config-encryption-key-change-me

# Database
REPOSITORY_DRIVER=memory
DATABASE_URL=postgres://user:password@localhost:5432/mindheal_db
# Required in production for refresh token rotation, logout revocation, and OTP storage.
REDIS_URL=

# CORS Security
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,https://yourproductionfrontend.com

# Email Delivery (SendGrid Production / SMTP Staging)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxx
# SENDGRID_FROM_EMAIL=noreply@mindheal.in
#
# Fallback SMTP Settings (Staging / Development)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM="MindHeal <your-email@example.com>"

# Indian SMS Gateway (MSG91 with TRAI / DLT Compliance)
# MSG91_AUTH_KEY=xxxxxx
# MSG91_TEMPLATE_ID=xxxxxx
# MSG91_SENDER_ID=MNDHEL
# MSG91_DLT_ENTITY_ID=xxxxxxxxxxxx

# External Service Keys (can also be configured via DB config table)
# FIREBASE_ADMIN_CREDENTIALS=...
# FIREBASE_USE_APPLICATION_DEFAULT=false
# FIREBASE_STORAGE_BUCKET=
# Required in production for wallet top-ups and payment webhook verification.
# RAZORPAY_KEY_ID=...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# GOOGLE_MAPS_API_KEY=...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
